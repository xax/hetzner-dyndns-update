## # Install service script:
## sudo install -m 0754 -D -t /opt/hetzner-dyndns-update dyndns-hetzner-http-service.py
##
## # Copy modified service file to systemd directory:
## sudo cp dyndns-hetzner-http-service.service /etc/systemd/system/
##
## # Reload systemd to recognize the new service:
## sudo systemctl daemon-reload
##
## # Enable the service to start on boot and actually start it:
## sudo systemctl enable --now dyndns-hetzner-http-service
##
## # Check status
## sudo systemctl status dyndns-hetzner-http-service


- Copy modified service file to systemd directory: \
  `sudo cp dyndns-hetzner-http-service.service /etc/systemd/system/`
- Reload systemd to recognize the new service: \
  `sudo systemctl daemon-reload`
- Enable the service to start on boot and actually start it: \
  `sudo systemctl enable --now dyndns-hetzner-http-service`
- Check status
  `sudo systemctl status dyndns-hetzner-http-service`


[Unit]
Description=Hetzner DynDNS HTTP Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hetzner-dyndns-update
ExecStart=/usr/bin/python3 /opt/hetzner-dyndns-update/dyndns-hetzner-http-service.py --ttl 60 -H @mydomain.tld www@mydomain.tld
Restart=on-failure
RestartSec=5
Environment=DYNDNS_HHS_TOKEN=s73kjbsesf63vdsr3b
Environment=DYNDNS_HHS_API_KEY=Ksdf97HJGH8we63hH86LKGG8dsfjHjvsdfjgJHF875BHNmvbsdf87543J7BJG65j

[Install]
WantedBy=multi-user.target
